# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/hotelpro?retryWrites=true&w=majority

# JWT secret — use a long random string
JWT_SECRET=your_super_secret_jwt_key_change_this

# Frontend URL (for CORS) — set to your Vercel URL after deployment
CLIENT_URL=http://localhost:5173

# Server port (Render sets this automatically)
PORT=5000

# Node environment
NODE_ENV=development
